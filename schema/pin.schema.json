{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-wiki.local/schema/pin.schema.json",
  "title": "LLM Wiki Pin Ledger v1.0",
  "description": "每页一个人工修正账本。一个字段最多一条 active replace pin。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "page", "updated_at", "pins"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "page": { "$ref": "#/$defs/pageId" },
    "updated_at": { "type": "string", "format": "date-time" },
    "pins": {
      "type": "array",
      "items": { "$ref": "#/$defs/pin" }
    }
  },
  "$defs": {
    "pageId": {
      "type": "string",
      "pattern": "^(index|source|entity|claim|story|metric|qa|scenario):[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin_id", "anchor", "mode", "value", "reason",
        "origin", "created_by", "created_at", "source_run", "status"
      ],
      "properties": {
        "pin_id": { "type": "string", "pattern": "^pin-[0-9A-Z]{26}$" },
        "anchor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": { "const": "field" },
                "path": { "type": "string", "pattern": "^/" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "heading"],
              "properties": {
                "kind": { "const": "section" },
                "heading": { "type": "string", "minLength": 3 },
                "quote": { "type": "string", "minLength": 5, "maxLength": 200 }
              }
            }
          ]
        },
        "mode": { "enum": ["replace", "must_include", "must_exclude"] },
        "original": { "type": ["string", "null"], "maxLength": 500 },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reason": { "type": "string", "minLength": 4, "maxLength": 200 },
        "origin": { "enum": ["review_edit", "manual", "migrated"] },
        "created_by": { "type": "string", "pattern": "^human:.+$" },
        "created_at": { "type": "string", "format": "date-time" },
        "source_run": { "type": ["string", "null"], "pattern": "^run-[0-9]{8}-[0-9]{2}$" },
        "status": { "enum": ["active", "pending_confirmation", "orphaned", "retired"] },
        "retired_at": { "type": ["string", "null"], "format": "date-time" },
        "retired_reason": { "type": ["string", "null"], "maxLength": 200 }
      }
    }
  }
}
