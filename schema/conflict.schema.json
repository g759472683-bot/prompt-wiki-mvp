{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-wiki.local/schema/conflict.schema.json",
  "title": "LLM Wiki Conflict Record v1.0",
  "description": "冲突只能由 compiler/rule/llm 创建；resolved 必须由 human:* 写入。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "conflict_id", "status", "kind", "severity",
    "detected_at", "detected_by", "run_id", "subject", "variants",
    "resolution", "audit"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "conflict_id": { "type": "string", "pattern": "^cfl-[0-9A-Z]{26}$" },
    "status": { "enum": ["open", "resolved", "dismissed"] },
    "kind": {
      "enum": [
        "numeric_mismatch", "scope_mismatch", "factual_contradiction",
        "temporal_supersede", "identity_duplicate", "duplicate_page"
      ]
    },
    "severity": { "enum": ["blocker", "major", "minor"] },
    "detected_at": { "type": "string", "format": "date-time" },
    "detected_by": { "type": "string", "pattern": "^(rule|llm|human):.+$" },
    "run_id": { "type": ["string", "null"], "pattern": "^run-[0-9]{8}-[0-9]{2}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages", "key"],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pageId" }
        },
        "field": { "type": ["string", "null"] },
        "key": { "type": "string", "minLength": 2, "maxLength": 60 }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "value", "evidence"],
        "properties": {
          "variant_id": { "type": "string", "pattern": "^v[0-9]+$" },
          "claim": { "type": "string", "maxLength": 120 },
          "value": { "type": "string", "minLength": 1, "maxLength": 120 },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "chosen", "rationale", "resolved_by", "resolved_at"],
      "properties": {
        "mode": {
          "enum": [null, "choose", "synthesize", "scope_split", "accept_both", "dismiss"]
        },
        "chosen": { "type": ["string", "null"], "pattern": "^v[0-9]+$" },
        "rationale": { "type": ["string", "null"], "maxLength": 500 },
        "resolved_by": { "type": ["string", "null"], "pattern": "^human:.+$" },
        "resolved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "due_at": { "type": ["string", "null"], "format": "date" },
    "audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "by", "action"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "by": { "type": "string", "minLength": 3 },
          "action": { "type": "string", "minLength": 3 },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["resolved", "dismissed"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolution": {
            "properties": {
              "mode": {
                "enum": ["choose", "synthesize", "scope_split", "accept_both", "dismiss"]
              },
              "resolved_by": { "type": "string", "pattern": "^human:.+$" },
              "resolved_at": { "type": "string", "format": "date-time" },
              "rationale": { "type": "string", "minLength": 10 }
            },
            "required": ["mode", "resolved_by", "resolved_at", "rationale"]
          }
        }
      }
    }
  ],
  "$defs": {
    "pageId": {
      "type": "string",
      "pattern": "^(index|source|entity|claim|story|metric|qa|scenario):[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_version", "block", "quote"],
      "properties": {
        "source": { "$ref": "#/$defs/pageId" },
        "source_version": { "type": "integer", "minimum": 1 },
        "block": { "type": "string", "pattern": "^b-[0-9]{4}$" },
        "quote": { "type": "string", "minLength": 5, "maxLength": 200 }
      }
    }
  }
}
