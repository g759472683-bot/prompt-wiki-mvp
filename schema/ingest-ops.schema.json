{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-wiki.local/schema/ingest-ops.schema.json",
  "title": "LLM Wiki Ingest Operations v1.0",
  "description": "Ingest 编译批次的操作计划。CREATE/CONFLICT 的完整内容放在 staging_path 指向的文件中。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "index_read", "ops"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^run-[0-9]{8}-[0-9]{2}$" },
    "index_read": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "pattern": "^index:" }
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/op" }
    }
  },
  "$defs": {
    "op": {
      "oneOf": [
        { "$ref": "#/$defs/create" },
        { "$ref": "#/$defs/update" },
        { "$ref": "#/$defs/link" },
        { "$ref": "#/$defs/noop" },
        { "$ref": "#/$defs/conflict" },
        { "$ref": "#/$defs/needsHuman" }
      ]
    },
    "base": {
      "type": "object",
      "required": ["op_id", "op", "reason"],
      "properties": {
        "op_id": { "type": "string", "pattern": "^op-[0-9]{2}$" },
        "reason": { "type": "string", "minLength": 4, "maxLength": 80 }
      }
    },
    "create": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "op": { "const": "CREATE" },
        "target": { "$ref": "#/$defs/pageId" },
        "page_type": {
          "enum": ["entity", "claim", "story", "metric", "qa", "scenario"]
        },
        "staging_path": { "type": "string", "minLength": 5 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^source:[a-z0-9-]+#b-[0-9]{4}$" }
        }
      },
      "required": ["op", "target", "page_type", "staging_path", "evidence"]
    },
    "update": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "op": { "const": "UPDATE" },
        "target": { "$ref": "#/$defs/pageId" },
        "base_revision": { "type": "integer", "minimum": 1 },
        "patch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "value"],
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "value": {}
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^source:[a-z0-9-]+#b-[0-9]{4}$" }
        }
      },
      "required": ["op", "target", "base_revision", "patch"]
    },
    "link": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "op": { "const": "LINK" },
        "from": { "$ref": "#/$defs/pageId" },
        "to": { "$ref": "#/$defs/pageId" },
        "mount": { "enum": ["index", "scenario"] },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "priority": { "enum": [1, 2, 3] },
            "must_hit": { "type": "boolean" }
          }
        }
      },
      "required": ["op", "from", "to", "mount"]
    },
    "noop": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "op": { "const": "NOOP" },
        "target": { "$ref": "#/$defs/pageId" },
        "covered_by": { "$ref": "#/$defs/pageId" }
      },
      "required": ["op", "target"]
    },
    "conflict": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "op": { "const": "CONFLICT" },
        "conflict_id": { "type": "string", "pattern": "^cfl-[0-9A-Z]{26}$" },
        "staging_path": { "type": "string", "minLength": 5 }
      },
      "required": ["op", "conflict_id", "staging_path"]
    },
    "needsHuman": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "op": { "const": "NEEDS_HUMAN" },
        "question": { "type": "string", "minLength": 6, "maxLength": 200 },
        "blocking": { "type": "boolean" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 120 }
        }
      },
      "required": ["op", "question", "blocking", "options"]
    },
    "pageId": {
      "type": "string",
      "pattern": "^(index|source|entity|claim|story|metric|qa|scenario):[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
